{
	"author": "o01011",
	"dependencies": {
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"branch-name-lint": "^3.0.1",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"http-status-codes": "^2.3.0",
		"knip": "^6.40.0",
		"swagger-jsdoc": "^6.3.0",
		"swagger-ui-express": "^5.0.1",
		"typescript": "^7.0.2",
		"uuid": "^14.0.1",
		"zod": "^4.6.5"
	},
	"description": "ExpressJS Backend",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@commitlint/types": "^21.2.3",
		"@ls-lint/ls-lint": "^2.3.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.4",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"lint-staged": "^17.6.0",
		"prisma": "7.10.0",
		"simple-git-hooks": "^2.14.0",
		"tsx": "^4.23.15"
	},
	"keywords": [],
	"license": "MIT",
	"main": "dist/server.js",
	"name": "expressjs-boilerplate",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start:dev": "tsx watch src/server.ts",
		"start:prod": "node dist/server.js",
		"db:generate": "prisma generate",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:migrate:reset": "prisma migrate reset",
		"db:push": "prisma db push",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio --browser none",
		"docker:compose:down": "docker compose -f docker-compose.yml down -v",
		"docker:compose:start": "docker compose -f docker-compose.yml start",
		"docker:compose:stop": "docker compose -f docker-compose.yml stop -t 10",
		"docker:compose:up": "docker compose -f docker-compose.yml up -d --no-color --timestamps --wait --wait-timeout 60",
		"lint:check": "biome lint",
		"lint:fix": "biome lint --write",
		"lint:format:check": "biome format",
		"lint:format:fix": "biome format --write",
		"lint:types:check": "tsc --noEmit",
		"lint:clean:check": "knip",
		"lint:fs:check": "ls-lint",
		"lint:branch:check": "branch-name-lint branch-name-lint.config.json",
		"git:hook:init": "simple-git-hooks",
		"git:hook:precommit": "lint-staged"
	},
	"type": "module",
	"version": "0.0.1"
}
